<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.readio.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NPM_PATH__</string>
    <string>run</string>
    <string>dev</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__READIO_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Keeps the Next.js dev server running across reboots/crashes so the
       RSS feed and capture form are always reachable, and so the nightly
       job (a separate agent) has something to hit. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__READIO_DIR__/data/logs/server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__READIO_DIR__/data/logs/server.err.log</string>
</dict>
</plist>
