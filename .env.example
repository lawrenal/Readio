# Copy to .env and fill in. See human-eyes.md for what's actually required
# right now vs. optional.

# SQLite — path is relative to the project root. No need to change this.
DATABASE_URL="file:./prisma/dev.db"

# --- AI (summarization + script-writing) ---
# Default is Open WebUI (self-hosted, no paid API key) — point this at
# your own Open WebUI instance's API base. AI_PROVIDER=openwebui below is
# set explicitly (rather than left to the code default) per a general
# preference for explicit config over implicit behavior — but
# getLlmProvider() (src/lib/llm.ts) defaults to openwebui either way if
# this is unset.
AI_PROVIDER=openwebui
OPENWEBUI_BASE_URL=
# Optional — many local Open WebUI setups run without auth on a trusted LAN.
# OPENWEBUI_API_KEY=
# The model name exactly as loaded in your Open WebUI instance.
OPENWEBUI_MODEL=

# To skip Open WebUI and talk to Ollama directly instead, set
# AI_PROVIDER=ollama and fill in OLLAMA_BASE_URL/OLLAMA_MODEL — see
# src/lib/settings.ts for the full list.

# To use a paid cloud provider instead, set AI_PROVIDER to one of:
# anthropic | openai | xai | gemini — and fill in that provider's key
# below. Without a working AI provider configured, every episode uses a
# plain template fallback (no real clustering/narration — see
# src/lib/episode-script.ts).

# Anthropic — https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# Optional — override the default models (see src/lib/ai.ts for why these
# defaults were chosen).
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5
# ANTHROPIC_SCRIPT_MODEL=claude-opus-5

# --- Text-to-speech ---
# Default is Kokoro-82M (self-hosted, no key, no config needed) — judged
# the best-sounding option after comparing it against macOS `say`
# (including the paid "Enhanced" voice downloads) and ElevenLabs. Runs
# fully locally via kokoro-js + onnxruntime-node; the first use downloads
# a ~90MB model file. TTS_PROVIDER=kokoro below is set explicitly (rather
# than left to the code default) per a general preference for explicit
# config over implicit behavior — but getTtsProvider() (src/lib/tts.ts)
# defaults to Kokoro either way if this is unset.
TTS_PROVIDER=kokoro
# Optional — defaults to af_heart (top-graded voice in Kokoro's own
# list, and female). Full list: import {KokoroTTS} from "kokoro-js" then
# inspect (await KokoroTTS.from_pretrained(...)).voices
# KOKORO_VOICE=af_heart

# To use a cloud provider instead, change TTS_PROVIDER above to one of:
# elevenlabs | azure | google | gemini | say — and fill in that
# provider's config below. None of these four cloud integrations have
# been tested against a real key (see human-eyes.md for the confidence
# level of each); Kokoro is the only one actually verified with real
# generated audio.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# Required alongside the key above. Pick a voice from your ElevenLabs
# account (Voice Library) or `GET /v1/voices`, then set its id here.
# ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_multilingual_v2.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Azure AI Speech — https://portal.azure.com (create a "Speech" resource,
# then Keys and Endpoint). Simplest cloud option to set up: one key, one
# region string, no OAuth.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Optional — defaults below. Full voice list via
# GET https://{region}.tts.speech.microsoft.com/cognitiveservices/voices/list
# AZURE_SPEECH_VOICE=en-US-JennyNeural
# AZURE_SPEECH_LANGUAGE=en-US

# Google Cloud Text-to-Speech — heavier setup than the others: create a
# GCP project, enable the Text-to-Speech API, create a service account
# with that access, download its JSON key, and point this at the file
# (Google's own library reads this env var name, not a custom one here).
# GOOGLE_APPLICATION_CREDENTIALS=
# Optional — defaults below (a Chirp3-HD voice).
# GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon
# GOOGLE_TTS_LANGUAGE=en-US

# Gemini TTS — https://aistudio.google.com/apikey . Simple API-key auth
# like ElevenLabs/Azure, but this is the least-confirmed integration of
# the four (see the warning atop src/lib/tts-gemini.ts) — try one of the
# others first if you want the safer bet.
# GEMINI_API_KEY=
# Optional — defaults below.
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts

# Optional — a specific macOS `say` voice, only used if TTS_PROVIDER=say
# above. Run `say -v ?` to list installed voices.
# SAY_VOICE=Samantha

# --- Security (see docs/security.md) ---
# Off by default. Only turn this on if you're exposing this app directly
# to the public internet with nothing else handling auth in front of it.
# BASIC_AUTH_ENABLED=true
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=choose-a-real-password

# Optional — encrypts API keys/secrets saved via /settings at rest.
# Unset means plaintext (same trust boundary as this .env file already
# sits in). Generate one with: openssl rand -base64 32
# SETTINGS_ENCRYPTION_KEY=
