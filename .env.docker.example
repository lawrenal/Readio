# Copy to .env (same directory as docker-compose.yml) and fill in.
# This is loaded via docker-compose's env_file — secrets only.
# Structural settings (DATABASE_URL, ENABLE_SCHEDULER, TTS_PROVIDER) are
# set directly in docker-compose.yml, not here, so they can't be
# accidentally overridden by a stray .env — don't duplicate them here.

# --- AI (summarization + script-writing) ---
# Default is Open WebUI (self-hosted, no paid API key) — point this at
# your own Open WebUI instance's API base, reachable from inside the
# container (not localhost — the container has its own).
OPENWEBUI_BASE_URL=
# Optional — many local Open WebUI setups run without auth on a trusted LAN.
# OPENWEBUI_API_KEY=
# The model name exactly as loaded in your Open WebUI instance.
OPENWEBUI_MODEL=

# To skip Open WebUI and talk to Ollama directly instead, override
# AI_PROVIDER=ollama in docker-compose.yml and fill in
# OLLAMA_BASE_URL/OLLAMA_MODEL here.

# To use a paid cloud provider instead, override AI_PROVIDER in
# docker-compose.yml to one of: anthropic | openai | xai | gemini — and
# set that provider's key here. Without a working AI provider configured,
# every episode uses a plain template fallback (no real
# clustering/narration).

# Anthropic — https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# Optional — override the default models.
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5
# ANTHROPIC_SCRIPT_MODEL=claude-opus-5

# Optional — override Kokoro's default voice (af_heart). See
# src/lib/tts-kokoro.ts for the full voice list.
# KOKORO_VOICE=af_heart

# Optional — override the nightly generation time (default 9pm local,
# i.e. the container's local time — see docker-compose.yml comments).
# Standard 5-field cron syntax.
# NIGHTLY_CRON=0 21 * * *

# To use a cloud TTS provider instead of Kokoro, override TTS_PROVIDER in
# docker-compose.yml (not here) and set that provider's key(s) here — see
# .env.example in the project root for the full list of provider-specific
# variables (ELEVENLABS_API_KEY, AZURE_SPEECH_KEY, etc).

# --- Security (see docs/security.md) ---
# Off by default. Only turn this on if you're exposing this app directly
# to the public internet with nothing else handling auth in front of it.
# BASIC_AUTH_ENABLED=true
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=choose-a-real-password

# Optional — encrypts API keys/secrets saved via /settings at rest.
# Unset means plaintext. Generate one with: openssl rand -base64 32
# SETTINGS_ENCRYPTION_KEY=
